# Copy to .env.local and fill in.

# Required for write APIs + MCP
SEBGD_ADMIN_TOKEN=

# Public site URL (RSS, metadata)
NEXT_PUBLIC_SITE_URL=https://sebgd.com

# Optional — Neon Postgres. When unset, content/posts/*.md is used.
DATABASE_URL=

# Optional — Vercel Blob for image uploads
BLOB_READ_WRITE_TOKEN=
